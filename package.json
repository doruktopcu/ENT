{
  "name": "elementary-number-theory-extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\"",
    "icons": "node scripts/generate_icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "package": "npm test && npm run lint && npm run build && mkdir -p release && rm -f release/number-theory-lab-$npm_package_version.zip && cd dist && zip -qrX ../release/number-theory-lab-$npm_package_version.zip . -x '.*' -x '*/.*'"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.1"
  }
}
