{
  "manifest_version": 3,
  "name": "Number Theory Lab",
  "version": "1.1.0",
  "description": "Number theory solvers with step-by-step derivations: gcd to CRT, primitive roots, RSA, primality tests, sums of squares and π(x).",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Number Theory Lab",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
